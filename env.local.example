# Copy this file to ".env.local" in the project root (same folder as package.json).
# Next.js loads .env.local in development.

NEXT_PUBLIC_API_URL=http://localhost:4000

# Firebase web app (Project settings → Your apps → SDK snippet). Required for Google sign-in.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://mongolian-games-default-rtdb.firebaseio.com/
