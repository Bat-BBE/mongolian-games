# `server/`-аас: хуулж `server/.env` болгоно. Удирдах хэсгээс (Railway, Fly, etc.) `DATABASE_URL` гэх мэтийг тохируул.
NODE_ENV=development
PORT=4000

# PostgreSQL (жишээ: Neon)
DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require

# CORS: фронт хуудасны нэг буюу олон origin — таслалаар. Production-д таны домэнийг бүтэн ORC болгоно.
# Жишээ: https://app.example.com,https://www.example.com
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Firebase Admin — JSON-ийг **нэг мөр** болгож escape хийнэ, эсвэл оролтын файлаас server-д ачаал
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_DATABASE_URL=https://project.firebaseio.com

# Admin (хамгаалсан маршрутууд) — аюулгүйн урт нууц
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# JWT_SECRET=                 # хамгийн багадаа 32 тэмдэг (optional боловч admin JWT-д ашиглагдвал зайлшгүй)
